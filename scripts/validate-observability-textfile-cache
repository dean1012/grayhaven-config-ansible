#!/usr/bin/env python3
"""Validate the GCS operation and billing-window telemetry cache contracts."""

from __future__ import annotations

from datetime import datetime, timezone
import json
import pathlib
import runpy
import tempfile
import urllib.error


REPO_ROOT = pathlib.Path(__file__).resolve().parents[1]
COLLECTOR = (
    REPO_ROOT / "roles" / "observability" / "files" / "grayhaven-observability-textfile"
)

BILLING_START = datetime(2026, 7, 1, 7, tzinfo=timezone.utc)


def billing_window(timestamp: int, month: str = "2026-07") -> tuple[datetime, datetime, str]:
    return BILLING_START, datetime.fromtimestamp(timestamp, timezone.utc), month


def validate_initial_refresh(
    counts: dict[str, float],
    refreshed_at: int,
    fresh: bool,
    cache_mode: int,
    month: str,
) -> None:
    """Validate the first cache population and its protected metadata."""
    if counts != {
        "Class A": 11.0,
        "Class B": 21.0,
    } or refreshed_at != 1_000 or not fresh or month != "2026-07":
        raise RuntimeError("Initial GCS operation telemetry refresh failed")
    if cache_mode != 0o600:
        raise RuntimeError("GCS operation telemetry cache must use mode 0600")


def validate_fresh_reuse(
    cached: tuple[dict[str, float], int, bool, str],
    counts: dict[str, float],
    refreshed_at: int,
    query_count: int,
) -> None:
    """Validate reuse before the refresh interval expires."""
    if cached != (counts, refreshed_at, True, "2026-07") or query_count != 1:
        raise RuntimeError("Fresh GCS operation telemetry cache was not reused")


def validate_expired_refresh(
    counts: dict[str, float], refreshed_at: int, fresh: bool
) -> None:
    """Validate collection after the refresh interval expires."""
    if counts != {
        "Class A": 12.0,
        "Class B": 22.0,
    } or refreshed_at != 4_601 or not fresh:
        raise RuntimeError("Expired GCS operation telemetry cache was not refreshed")


def validate_failure_fallback(
    cached: tuple[dict[str, float], int, bool, str],
    counts: dict[str, float],
    refreshed_at: int,
    *,
    expected_fresh: bool,
) -> None:
    """Validate cached fallback following a collection failure."""
    if cached != (counts, refreshed_at, expected_fresh, "2026-07"):
        state = "retained" if expected_fresh else "marked stale"
        raise RuntimeError(f"Cached telemetry was not {state} after a refresh failure")


def validate_bucket_isolation(cache_value: object) -> None:
    """Reject a cache entry produced for a different bucket set."""
    if cache_value is not None:
        raise RuntimeError("GCS operation telemetry cache accepted a different bucket set")


def validate_query_scope(requested_filters: list[str], buckets: set[str]) -> None:
    """Require one Monitoring query constrained to every expected bucket."""
    if len(requested_filters) != 1 or not all(
        f'resource.labels.bucket_name = "{bucket}"' in requested_filters[0]
        for bucket in buckets
    ):
        raise RuntimeError("Cloud Monitoring query was not filtered to expected GCS buckets")


def validate_billing_query(
    requests: list[dict[str, str]],
    start_time: datetime,
    end_time: datetime,
) -> None:
    if len(requests) != 1:
        raise RuntimeError("Expected one billing-window query")
    request = requests[0]
    if request.get("interval.startTime") != start_time.isoformat().replace("+00:00", "Z"):
        raise RuntimeError("Billing query start did not use the explicit UTC window")
    if request.get("interval.endTime") != end_time.isoformat().replace("+00:00", "Z"):
        raise RuntimeError("Billing query end did not use the explicit UTC window")


def validate_canonical_metrics(namespace: dict[str, object], module_globals: dict[str, object]) -> None:
    config = {
        "host": {"client": "grayhaven", "control_node": True, "environment": "prod"},
        "hosts": [],
        "gcs": {"enabled": True, "location": "US-EAST1", "project_id": "grayhaven"},
    }
    module_globals["gcs_status"] = lambda location: ("Operational", 1, 1)
    module_globals["cached_gcs_operation_counts"] = lambda gcs_config, bucket_names: (
        {"Class A": 1.0, "Class B": 2.0},
        1_000,
        True,
        "2026-07",
    )
    module_globals["google_monitoring_status"] = lambda location: ("Operational", 1, 1)
    module_globals["cached_google_monitoring_usage"] = lambda gcs_config: (
        5.0,
        1_000,
        True,
        "2026-07",
    )
    rendered = "\n".join(
        namespace["render_gcs_metrics"](config)
        + namespace["render_google_monitoring_metrics"](config)
    )
    canonical = (
        "grayhaven_gcs_restic_billing_month_operations_total",
        "grayhaven_google_monitoring_billing_month_series_total",
    )
    old = (
        "grayhaven_gcs_restic_monthly_operations_total",
        "grayhaven_google_monitoring_monthly_billed_series_total",
    )
    if any(name not in rendered for name in canonical) or any(name in rendered for name in old):
        raise RuntimeError("Canonical Google billing metric names are incorrect")
    if rendered.count('month="2026-07"') != 3:
        raise RuntimeError("Canonical Google billing metric labels are incorrect")


def main() -> int:
    namespace = runpy.run_path(str(COLLECTOR))
    module_globals = namespace["cached_gcs_operation_counts"].__globals__
    real_gcs_operation_counts = namespace["gcs_operation_counts"]
    now = [1_000]
    query_count = [0]
    requested_filters: list[str] = []
    requested_queries: list[dict[str, str]] = []
    buckets = {"grayhaven-core-prod-web-01-restic", "grayhaven-sec-prod-bastion-01-restic"}

    def operation_counts(
        project_id: str,
        token: str,
        bucket_names: set[str],
        start_time: datetime,
        end_time: datetime,
    ) -> dict[str, float]:
        del project_id, token
        query_count[0] += 1
        if bucket_names != buckets:
            raise RuntimeError("Unexpected bucket set")
        expected_start, expected_end, expected_month = billing_window(now[0])
        del expected_month
        if (start_time, end_time) != (expected_start, expected_end):
            raise RuntimeError("GCS query did not use the deterministic billing window")
        return {
            "Class A": 10.0 + query_count[0],
            "Class B": 20.0 + query_count[0],
        }

    with tempfile.TemporaryDirectory() as temp_dir:
        cache_path = pathlib.Path(temp_dir) / "gcs-operation-counts.json"
        config = {
            "credentials_file": "/unused/test-credentials.json",
            "operation_cache_file": str(cache_path),
            "operation_refresh_seconds": 3_600,
            "operation_stale_seconds": 10_800,
            "project_id": "grayhaven",
        }
        module_globals["google_billing_window"] = lambda: billing_window(now[0])
        module_globals["monitoring_token"] = lambda credentials_file: "test-token"
        module_globals["gcs_operation_counts"] = operation_counts

        counts, refreshed_at, fresh, month = namespace["cached_gcs_operation_counts"](config, buckets)
        validate_initial_refresh(
            counts,
            refreshed_at,
            fresh,
            cache_path.stat().st_mode & 0o777,
            month,
        )

        now[0] = 1_100
        cached = namespace["cached_gcs_operation_counts"](config, buckets)
        validate_fresh_reuse(cached, counts, refreshed_at, query_count[0])

        now[0] = 4_601
        counts, refreshed_at, fresh, month = namespace["cached_gcs_operation_counts"](config, buckets)
        validate_expired_refresh(counts, refreshed_at, fresh)

        def failed_operation_counts(*args: object, **kwargs: object) -> dict[str, float]:
            del args, kwargs
            raise urllib.error.URLError("expected validation failure")

        module_globals["gcs_operation_counts"] = failed_operation_counts
        now[0] = 8_202
        validate_failure_fallback(
            namespace["cached_gcs_operation_counts"](config, buckets),
            counts,
            refreshed_at,
            expected_fresh=True,
        )

        now[0] = 15_402
        validate_failure_fallback(
            namespace["cached_gcs_operation_counts"](config, buckets),
            counts,
            refreshed_at,
            expected_fresh=False,
        )

        validate_bucket_isolation(
            namespace["load_gcs_operation_cache"](
                cache_path,
                "grayhaven",
                {"unexpected-bucket"},
                "2026-07",
            )
        )
        valid_cache = json.loads(cache_path.read_text(encoding="utf-8"))
        for key, value in (
            ("version", module_globals["GCS_OPERATION_CACHE_VERSION"] - 1),
            ("project_id", "other"),
            ("month", "2026-06"),
            ("bucket_names", "not-a-list"),
            ("counts", {"Class A": True}),
            ("refreshed_at", True),
        ):
            invalid_cache = dict(valid_cache)
            invalid_cache[key] = value
            cache_path.write_text(json.dumps(invalid_cache), encoding="utf-8")
            if namespace["load_gcs_operation_cache"](
                cache_path, "grayhaven", buckets, "2026-07"
            ) is not None:
                raise RuntimeError(f"GCS cache accepted invalid {key}")
        cache_path.write_text("malformed", encoding="utf-8")
        if namespace["load_gcs_operation_cache"](
            cache_path, "grayhaven", buckets, "2026-07"
        ) is not None:
            raise RuntimeError("GCS cache accepted malformed JSON")
        usage_path = pathlib.Path(temp_dir) / "monitoring-usage.json"
        valid_usage = {
            "version": module_globals["GOOGLE_MONITORING_USAGE_CACHE_VERSION"],
            "project_id": "grayhaven",
            "month": "2026-07",
            "billed_series": 10,
            "refreshed_at": 1_000,
        }
        usage_path.write_text(json.dumps(valid_usage), encoding="utf-8")
        if namespace["load_google_monitoring_usage_cache"](
            usage_path, "grayhaven", "2026-07"
        ) != valid_usage:
            raise RuntimeError("Valid Cloud Monitoring usage cache was rejected")
        for key, value in (
            ("version", module_globals["GOOGLE_MONITORING_USAGE_CACHE_VERSION"] - 1),
            ("project_id", "other"),
            ("month", "2026-06"),
            ("billed_series", True),
            ("refreshed_at", True),
        ):
            invalid_usage = dict(valid_usage)
            invalid_usage[key] = value
            usage_path.write_text(json.dumps(invalid_usage), encoding="utf-8")
            if namespace["load_google_monitoring_usage_cache"](
                usage_path, "grayhaven", "2026-07"
            ) is not None:
                raise RuntimeError(f"Cloud Monitoring usage cache accepted invalid {key}")

    def monitoring_request(
        project_id: str,
        path: str,
        query: dict[str, str],
        token: str,
    ) -> dict[str, object]:
        del project_id, path, token
        requested_filters.append(query["filter"])
        requested_queries.append(query)
        bucket = sorted(buckets)[0]
        return {
            "timeSeries": [
                {
                    "resource": {"labels": {"bucket_name": bucket}},
                    "metric": {"labels": {"method": "storage.objects.insert"}},
                    "points": [
                        {
                            "interval": {
                                "startTime": "2026-06-30T07:00:00Z",
                                "endTime": "2026-07-01T07:00:00Z",
                            },
                            "value": {"int64Value": "50"},
                        },
                        {
                            "interval": {
                                "startTime": "2026-07-01T07:00:00Z",
                                "endTime": "2026-07-27T12:00:00Z",
                            },
                            "value": {"int64Value": "1"},
                        },
                    ],
                },
                {
                    "resource": {"labels": {"bucket_name": bucket}},
                    "metric": {"labels": {"method": "storage.objects.get"}},
                    "points": [
                        {
                            "interval": {
                                "startTime": "2026-07-01T07:00:00Z",
                                "endTime": "2026-07-27T12:00:00Z",
                            },
                            "value": {"int64Value": "2"},
                        }
                    ],
                },
                {
                    "resource": {"labels": {"bucket_name": bucket}},
                    "metric": {"labels": {"method": "DeleteObject"}},
                    "points": [
                        {
                            "interval": {
                                "startTime": "2026-07-01T07:00:00Z",
                                "endTime": "2026-07-27T12:00:00Z",
                            },
                            "value": {"int64Value": "3"},
                        }
                    ],
                },
                {
                    "resource": {"labels": {"bucket_name": bucket}},
                    "metric": {"labels": {"method": "future.method"}},
                    "points": [
                        {
                            "interval": {
                                "startTime": "2026-07-01T07:00:00Z",
                                "endTime": "2026-07-27T12:00:00Z",
                            },
                            "value": {"int64Value": "4"},
                        }
                    ],
                },
            ]
        }

    module_globals["monitoring_request"] = monitoring_request
    module_globals["gcs_operation_counts"] = real_gcs_operation_counts
    start_time, end_time, _ = billing_window(1_000)
    counts = real_gcs_operation_counts(
        "grayhaven", "test-token", buckets, start_time, end_time
    )
    if counts != {"Class A": 1.0, "Class B": 2.0}:
        raise RuntimeError("GCS operation interval or class filtering failed")
    validate_query_scope(requested_filters, buckets)
    validate_billing_query(requested_queries, start_time, end_time)
    validate_canonical_metrics(namespace, module_globals)

    return 0


if __name__ == "__main__":
    raise SystemExit(main())
