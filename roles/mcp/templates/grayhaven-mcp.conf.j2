# Managed by Ansible. Local changes will be overwritten.

{% set download_path = (mcp_repository_configuration | combine(mcp_config_overrides, recursive=true)).file_transfers.download_path %}
map $uri $grayhaven_mcp_safe_path {
    default $uri;
    "~^/connect/" /connect/[redacted];
    "~^{{ download_path }}/" {{ download_path }}/[redacted];
}

log_format grayhaven_mcp
    '$remote_addr - $remote_user [$time_local] '
    '"$request_method $grayhaven_mcp_safe_path $server_protocol" '
    '$status $body_bytes_sent "-" "$http_user_agent"';

server {
    listen 443 ssl;
    server_name {{ mcp.hostname }};
    ssl_certificate /etc/letsencrypt/live/{{ mcp.hostname }}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{{ mcp.hostname }}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers PROFILE=SYSTEM;
    ssl_session_cache shared:SSL:10m;
    add_header X-Robots-Tag "noindex, nofollow, noarchive" always;
    # Omit query strings, transfer capabilities, approval IDs, and Referer URLs.
    access_log /var/log/nginx/mcp.access.log grayhaven_mcp;
    error_log /var/log/nginx/mcp.error.log warn;
    client_max_body_size 40m;
    location / {
        proxy_pass http://127.0.0.1:{{ mcp_host_port }};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_read_timeout 900s;
    }
}
