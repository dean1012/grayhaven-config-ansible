# Managed by Ansible.
server {
    listen 443 ssl;
    server_name {{ mcp.hostname }};
    ssl_certificate /etc/letsencrypt/live/{{ mcp.hostname }}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{{ mcp.hostname }}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers PROFILE=SYSTEM;
    ssl_session_cache shared:SSL:10m;
    add_header X-Robots-Tag "noindex, nofollow, noarchive" always;
    # OAuth queries and temporary transfer links must not enter access logs.
    access_log off;
    error_log /var/log/nginx/mcp.error.log warn;
    client_max_body_size 40m;
    location / {
        proxy_pass http://127.0.0.1:{{ mcp_host_port }};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_read_timeout 900s;
    }
}
