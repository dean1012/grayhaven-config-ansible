# fail2ban helpers

def normalize_ip_token(value: str) -> str:
    token = value.strip(" \t'\"[](),")
    if token.endswith(":"):
        token = token[:-1]

    try:
        return str(ipaddress.ip_address(token))
    except ValueError:
        return ""


def format_fail2ban_expiry_date(value: str) -> str:
    expiry_text = value.rsplit("=", 1)[-1].strip()
    match = re.search(r"\d{4}-\d{2}-\d{2} \d{2}:\d{2}:\d{2}", expiry_text)
    if not match:
        return value

    try:
        expiry = datetime.strptime(match.group(0), "%Y-%m-%d %H:%M:%S").astimezone()
    except ValueError:
        return value

    hour = expiry.hour % 12 or 12
    return f"{expiry:%Y-%m-%d} {hour}:{expiry:%M} {expiry:%p} {expiry.tzname()}"


def fail2ban_ban_expiry_dates(jail: str) -> dict[str, str]:
    try:
        result = subprocess.run(
            ["/usr/bin/fail2ban-client", "get", jail, "banip", "--with-time"],
            capture_output=True,
            check=False,
            text=True,
            timeout=15,
        )
    except (OSError, subprocess.SubprocessError):
        return {}

    if result.returncode != 0:
        return {}

    expiry_dates: dict[str, str] = {}
    for raw_line in result.stdout.splitlines():
        for raw_token in raw_line.split():
            banned_ip = normalize_ip_token(raw_token)
            if not banned_ip:
                continue

            expiry_dates[banned_ip] = format_fail2ban_expiry_date(
                raw_line.split(raw_token, 1)[1].strip(" \t:-")
            )
            break

    return expiry_dates


def fail2ban_status(jail: str) -> tuple[int, int, int, list[str]]:
    def parse_count(value: str) -> int:
        try:
            return int(value.strip() or "0")
        except ValueError:
            return 0

    try:
        result = subprocess.run(
            ["/usr/bin/fail2ban-client", "status", jail],
            capture_output=True,
            check=False,
            text=True,
            timeout=15,
        )
    except (OSError, subprocess.SubprocessError):
        return 0, 0, 0, []

    if result.returncode != 0:
        return 0, 0, 0, []

    current_banned = 0
    total_banned = 0
    banned_ips: list[str] = []
    for raw_line in result.stdout.splitlines():
        status_line = raw_line.strip()
        if status_line.startswith(("|-", "`-")):
            status_line = status_line[2:].strip()

        if status_line.startswith("Currently banned:"):
            current_banned = parse_count(status_line.split(":", 1)[1])
        elif status_line.startswith("Total banned:"):
            total_banned = parse_count(status_line.split(":", 1)[1])
        elif status_line.startswith("Banned IP list:"):
            banned_ips = status_line.split(":", 1)[1].split()

    return 1, current_banned, total_banned, banned_ips


# Metric rendering

def render_expected_restic_repositories(config: dict[str, Any]) -> list[str]:
    current_host = config["host"]
    if not current_host.get("control_node"):
        return []

    repositories = config.get("restic", {}).get("repositories", [])
    output = [
        "# HELP grayhaven_restic_repository_expected Expected restic repository marker.",
        "# TYPE grayhaven_restic_repository_expected gauge",
    ]
    for host in config.get("hosts", []):
        for repository in repositories:
            metric_labels = host_labels(host)
            metric_labels["repository"] = repository
            output.append(line("grayhaven_restic_repository_expected", metric_labels, 1))

    return output


def render_gcs_metrics(config: dict[str, Any]) -> list[str]:
    current_host = config["host"]
    gcs_config = config.get("gcs", {})
    if not current_host.get("control_node") or not gcs_config.get("enabled"):
        return []

    metric_base = {
        "client": current_host["client"],
        "environment": current_host["environment"],
        "location": gcs_config.get("location", ""),
        "project_id": gcs_config.get("project_id", ""),
    }
    status, status_value, service_telemetry_success = gcs_status(str(gcs_config.get("location", "")))
    status_labels = dict(metric_base)
    status_labels["product"] = GOOGLE_CLOUD_STORAGE_PRODUCT_TITLE
    status_labels["status"] = status

    output = [
        "# HELP grayhaven_gcs_service_telemetry_success Google Cloud Storage public service-health telemetry collection success.",
        "# TYPE grayhaven_gcs_service_telemetry_success gauge",
        "# HELP grayhaven_gcs_service_status Google Cloud Storage public service-health status.",
        "# TYPE grayhaven_gcs_service_status gauge",
        line("grayhaven_gcs_service_telemetry_success", metric_base, service_telemetry_success),
        "# HELP grayhaven_gcs_restic_telemetry_success GCS restic telemetry collection success.",
        "# TYPE grayhaven_gcs_restic_telemetry_success gauge",
        (
            "# HELP grayhaven_gcs_restic_telemetry_last_success_timestamp_seconds "
            "Unix timestamp of the last successful GCS restic operation telemetry refresh."
        ),
        "# TYPE grayhaven_gcs_restic_telemetry_last_success_timestamp_seconds gauge",
    ]
    if service_telemetry_success:
        output.append(line("grayhaven_gcs_service_status", status_labels, status_value))

    telemetry_labels = dict(metric_base)
    telemetry_labels["scope"] = "restic"

    try:
        operation_counts, refreshed_at, telemetry_fresh = cached_gcs_operation_counts(
            gcs_config,
            expected_bucket_names(config.get("hosts", [])),
        )
    except (KeyError, OSError, RuntimeError, ValueError, urllib.error.URLError, json.JSONDecodeError):
        output.append(line("grayhaven_gcs_restic_telemetry_success", telemetry_labels, 0))
        return output

    output.append(
        line("grayhaven_gcs_restic_telemetry_success", telemetry_labels, int(telemetry_fresh))
    )
    output.append(
        line(
            "grayhaven_gcs_restic_telemetry_last_success_timestamp_seconds",
