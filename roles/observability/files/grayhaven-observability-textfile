def label_value(value: object) -> str:
    return str(value).replace("\\", "\\\\").replace('"', '\\"').replace("\n", "\\n")


def labels(values: dict[str, object]) -> str:
    rendered = ",".join(f'{key}="{label_value(value)}"' for key, value in sorted(values.items()))
    return f"{{{rendered}}}"


def line(name: str, metric_labels: dict[str, object], value: object) -> str:
    return f"{name}{labels(metric_labels)} {value}"


def host_labels(host: dict[str, Any]) -> dict[str, object]:
    return {
        "client": host["client"],
        "environment": host["environment"],
        "host": host["fqdn"],
        "project": host["project"],
        "role": host["role"],
    }


# HTTP helpers

def request_json(url: str, headers: dict[str, str] | None = None) -> Any:
    request = urllib.request.Request(url, headers=headers or {})
    with urllib.request.urlopen(request, timeout=30) as response:
        return json.loads(response.read().decode("utf-8"))


def post_form_json(url: str, data: dict[str, str]) -> Any:
    encoded_data = urllib.parse.urlencode(data).encode("utf-8")
    request = urllib.request.Request(
        url,
        data=encoded_data,
        headers={
            "Accept": "application/json",
            "Content-Type": "application/x-www-form-urlencoded",
        },
        method="POST",
    )
    with urllib.request.urlopen(request, timeout=30) as response:
        return json.loads(response.read().decode("utf-8"))


def base64url(data: bytes) -> str:
    return base64.urlsafe_b64encode(data).rstrip(b"=").decode("ascii")


def google_token(credentials_file: str, scope: str) -> str:
    with open(credentials_file, encoding="utf-8") as credentials_handle:
        credentials = json.load(credentials_handle)

    now = int(time.time())
    token_uri = credentials.get("token_uri", "https://oauth2.googleapis.com/token")
    header = {"alg": "RS256", "typ": "JWT"}
    payload = {
        "aud": token_uri,
        "exp": now + 3600,
        "iat": now,
        "iss": credentials["client_email"],
        "scope": scope,
    }

    signing_input = ".".join(
        [
            base64url(json.dumps(header, separators=(",", ":")).encode("utf-8")),
            base64url(json.dumps(payload, separators=(",", ":")).encode("utf-8")),
        ]
    )
    private_key = serialization.load_pem_private_key(
        credentials["private_key"].encode("utf-8"),
        password=None,
    )
    if not isinstance(private_key, rsa.RSAPrivateKey):
        raise RuntimeError("Google Cloud service account key is not an RSA private key")

    signature = private_key.sign(
        signing_input.encode("ascii"),
        padding.PKCS1v15(),
        hashes.SHA256(),
    )
    assertion = f"{signing_input}.{base64url(signature)}"
    response = post_form_json(
        token_uri,
        {
            "assertion": assertion,
            "grant_type": "urn:ietf:params:oauth:grant-type:jwt-bearer",
        },
    )
    token = response.get("access_token")
    if not isinstance(token, str) or not token:
        raise RuntimeError("Google Cloud credentials did not return an access token")
    return token


def monitoring_token(credentials_file: str) -> str:
    return google_token(credentials_file, GCS_MONITORING_SCOPE)


def expected_bucket_names(hosts: list[dict[str, Any]]) -> set[str]:
    return {f"{host['short_hostname']}-restic" for host in hosts}


def monitoring_request(project_id: str, path: str, query: dict[str, str], token: str) -> dict[str, Any]:
    encoded_project = urllib.parse.quote(project_id, safe="")
    headers = {
        "Accept": "application/json",
        "Authorization": f"Bearer {token}",
    }
    url = (
        f"https://monitoring.googleapis.com/v3/projects/{encoded_project}/{path}"
        f"?{urllib.parse.urlencode(query)}"
    )
    return request_json(url, headers)


def point_value(point: dict[str, Any]) -> float:
    value = point.get("value", {})
    if "int64Value" in value:
        return float(value["int64Value"])
    if "doubleValue" in value:
        return float(value["doubleValue"])
    return 0.0


def gcs_operation_class(method: str) -> str:
    return GCS_OPERATION_CLASSES.get(method, "Unknown")


def gcs_operation_counts(
    project_id: str,
    token: str,
    bucket_names: set[str],
) -> dict[str, float]:
    if not bucket_names:
        return {operation_class: 0.0 for operation_class in GCS_OPERATION_CLASSES_REPORTED}

    end_time = datetime.now(timezone.utc)
    start_time = end_time.replace(day=1, hour=0, minute=0, second=0, microsecond=0)
    alignment_seconds = max(60, int((end_time - start_time).total_seconds()))
    bucket_filter = " OR ".join(
        f'resource.labels.bucket_name = "{bucket_name}"'
        for bucket_name in sorted(bucket_names)
    )
    query = {
        "filter": (
            'metric.type = "storage.googleapis.com/api/request_count" '
            'AND resource.type = "gcs_bucket" '
            f"AND ({bucket_filter})"
        ),
        "interval.startTime": start_time.isoformat().replace("+00:00", "Z"),
        "interval.endTime": end_time.isoformat().replace("+00:00", "Z"),
        "aggregation.alignmentPeriod": f"{alignment_seconds}s",
        "aggregation.perSeriesAligner": "ALIGN_DELTA",
        "pageSize": "10000",
    }
    counts = {operation_class: 0.0 for operation_class in GCS_OPERATION_CLASSES_REPORTED}

    while True:
        response = monitoring_request(project_id, "timeSeries", query, token)
        for series in response.get("timeSeries", []):
            bucket_name = series.get("resource", {}).get("labels", {}).get("bucket_name", "")
            if bucket_name not in bucket_names:
                continue

            method = str(series.get("metric", {}).get("labels", {}).get("method", ""))
            operation_class = gcs_operation_class(method)
            counts[operation_class] += sum(point_value(point) for point in series.get("points", []))

        next_page = response.get("nextPageToken")
        if not next_page:
            return counts
        query["pageToken"] = next_page


def load_gcs_operation_cache(
    path: pathlib.Path,
    project_id: str,
    bucket_names: set[str],
    month: str,
) -> dict[str, Any] | None:
    try:
        cache = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError):
        return None

    if not isinstance(cache, dict):
        return None
    if cache.get("version") != GCS_OPERATION_CACHE_VERSION:
        return None
    if cache.get("project_id") != project_id or cache.get("month") != month:
        return None
    if cache.get("bucket_names") != sorted(bucket_names):
        return None
    counts = cache.get("counts")
    refreshed_at = cache.get("refreshed_at")
    if not isinstance(counts, dict) or not isinstance(refreshed_at, int):
        return None
    if not all(
        isinstance(counts.get(operation_class), (int, float))
        for operation_class in GCS_OPERATION_CLASSES_REPORTED
    ):
        return None
    return cache


def cached_gcs_operation_counts(
    gcs_config: dict[str, Any],
    bucket_names: set[str],
) -> tuple[dict[str, float], int, bool]:
    project_id = str(gcs_config["project_id"])
    cache_path = pathlib.Path(str(gcs_config["operation_cache_file"]))
    refresh_seconds = max(60, int(gcs_config["operation_refresh_seconds"]))
    stale_seconds = max(refresh_seconds, int(gcs_config["operation_stale_seconds"]))
    now = int(time.time())
    month = datetime.now(timezone.utc).strftime("%Y-%m")
    cache = load_gcs_operation_cache(cache_path, project_id, bucket_names, month)

    if cache is None or now - int(cache["refreshed_at"]) >= refresh_seconds:
        try:
            monitor_token = monitoring_token(str(gcs_config["credentials_file"]))
            counts = gcs_operation_counts(project_id, monitor_token, bucket_names)
        except (OSError, RuntimeError, urllib.error.URLError, json.JSONDecodeError):
            if cache is None:
                raise
        else:
            cache = {
                "bucket_names": sorted(bucket_names),
                "counts": counts,
                "month": month,
                "project_id": project_id,
                "refreshed_at": now,
                "version": GCS_OPERATION_CACHE_VERSION,
            }
            atomic_write(
                cache_path,
                json.dumps(cache, separators=(",", ":"), sort_keys=True) + "\n",
                mode=0o600,
            )

    if cache is None:
        raise RuntimeError("GCS operation telemetry cache is unavailable")
    refreshed_at = int(cache["refreshed_at"])
    counts = {
        operation_class: float(cache["counts"][operation_class])
        for operation_class in GCS_OPERATION_CLASSES_REPORTED
    }
    return counts, refreshed_at, now - refreshed_at <= stale_seconds


def monitoring_billed_series_total(project_id: str, token: str) -> float:
    end_time = datetime.now(timezone.utc)
    start_time = end_time.replace(day=1, hour=0, minute=0, second=0, microsecond=0)
    alignment_seconds = max(60, int((end_time - start_time).total_seconds()))
    query = {
        "filter": (
            'metric.type = '
            '"monitoring.googleapis.com/billing/time_series_billed_for_queries_count"'
        ),
        "interval.startTime": start_time.isoformat().replace("+00:00", "Z"),
        "interval.endTime": end_time.isoformat().replace("+00:00", "Z"),
        "aggregation.alignmentPeriod": f"{alignment_seconds}s",
        "aggregation.perSeriesAligner": "ALIGN_SUM",
        "aggregation.crossSeriesReducer": "REDUCE_SUM",
        "pageSize": "10000",
    }
    response = monitoring_request(project_id, "timeSeries", query, token)
    series = response.get("timeSeries", [])
    if len(series) > 1 or response.get("nextPageToken"):
        raise RuntimeError("Cloud Monitoring billing query returned unexpected cardinality")
    return sum(point_value(point) for item in series for point in item.get("points", []))


def load_google_monitoring_usage_cache(
    path: pathlib.Path,
    project_id: str,
    month: str,
) -> dict[str, Any] | None:
    try:
        cache = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError):
        return None

    if not isinstance(cache, dict):
        return None
    if cache.get("version") != GOOGLE_MONITORING_USAGE_CACHE_VERSION:
        return None
    if cache.get("project_id") != project_id or cache.get("month") != month:
        return None
    if not isinstance(cache.get("billed_series"), (int, float)):
        return None
    if not isinstance(cache.get("refreshed_at"), int):
        return None
    return cache


def cached_google_monitoring_usage(gcs_config: dict[str, Any]) -> tuple[float, int, bool]:
    project_id = str(gcs_config["project_id"])
    cache_path = pathlib.Path(str(gcs_config["monitoring_usage_cache_file"]))
    refresh_seconds = max(60, int(gcs_config["monitoring_usage_refresh_seconds"]))
    stale_seconds = max(refresh_seconds, int(gcs_config["monitoring_usage_stale_seconds"]))
    now = int(time.time())
    month = datetime.now(timezone.utc).strftime("%Y-%m")
    cache = load_google_monitoring_usage_cache(cache_path, project_id, month)

    if cache is None or now - int(cache["refreshed_at"]) >= refresh_seconds:
        try:
            token = monitoring_token(str(gcs_config["credentials_file"]))
            billed_series = monitoring_billed_series_total(project_id, token)
        except (OSError, RuntimeError, urllib.error.URLError, json.JSONDecodeError):
            if cache is None:
                raise
        else:
            cache = {
                "billed_series": billed_series,
                "month": month,
                "project_id": project_id,
                "refreshed_at": now,
                "version": GOOGLE_MONITORING_USAGE_CACHE_VERSION,
            }
            atomic_write(
                cache_path,
                json.dumps(cache, separators=(",", ":"), sort_keys=True) + "\n",
                mode=0o600,
            )

    if cache is None:
        raise RuntimeError("Cloud Monitoring usage telemetry cache is unavailable")
    refreshed_at = int(cache["refreshed_at"])
    return (
        float(cache["billed_series"]),
        refreshed_at,
        now - refreshed_at <= stale_seconds,
    )


# Google Cloud public service-health helpers

def location_matches(configured_location: str, affected_locations: list[dict[str, Any]]) -> bool:
    if not affected_locations:
        return True

    normalized_location = configured_location.lower()
    for location in affected_locations:
        candidates = {
            str(location.get("id", "")).lower(),
            str(location.get("title", "")).lower(),
        }
        if "global" in candidates:
            return True
        if normalized_location in candidates:
            return True
        if normalized_location == "us" and any("united states" in candidate for candidate in candidates):
            return True
        if any(f" {normalized_location} " in f" {candidate} " for candidate in candidates):
            return True

    return False


def google_cloud_product_id(product_title: str, fallback_product_id: str) -> str:
    try:
        products = request_json(GOOGLE_CLOUD_PRODUCTS_URL).get("products", [])
    except (OSError, urllib.error.URLError, json.JSONDecodeError):
        return fallback_product_id

    for product in products:
        if product.get("title") == product_title:
            return str(product.get("id", fallback_product_id))

    return fallback_product_id


def google_cloud_status(
    product_title: str,
    fallback_product_id: str,
    configured_location: str,
) -> tuple[str, int, int]:
    product_id = google_cloud_product_id(product_title, fallback_product_id)
    try:
        incidents = request_json(GOOGLE_CLOUD_INCIDENTS_URL)
    except (OSError, urllib.error.URLError, json.JSONDecodeError):
        return "Unknown", 0, 0

    for incident in incidents:
        if incident.get("end"):
            continue

        affected_products = incident.get("affected_products", [])
        if not any(product.get("id") == product_id for product in affected_products):
            continue

        if not location_matches(configured_location, incident.get("currently_affected_locations", [])):
            continue

        status = incident.get("status_impact") or incident.get("severity") or "Incident"
        return str(status).replace("_", " ").title(), 0, 1

    return "Operational", 1, 1


def gcs_status(configured_location: str) -> tuple[str, int, int]:
    return google_cloud_status(
        GOOGLE_CLOUD_STORAGE_PRODUCT_TITLE,
        GOOGLE_CLOUD_STORAGE_PRODUCT_ID,
        configured_location,
    )


def google_monitoring_status(configured_location: str) -> tuple[str, int, int]:
    return google_cloud_status(
        GOOGLE_CLOUD_MONITORING_PRODUCT_TITLE,
        GOOGLE_CLOUD_MONITORING_PRODUCT_ID,
        configured_location,
    )


