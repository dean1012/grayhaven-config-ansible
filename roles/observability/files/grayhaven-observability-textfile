def render_proton_metrics(config: dict[str, Any]) -> list[str]:
    current_host = config["host"]
    proton_config = config.get("proton", {})
    if not current_host.get("control_node") or not proton_config.get("enabled"):
        return []

    services = proton_config.get("services", [])
    if not services:
        return []

    metric_base = {
        "client": current_host["client"],
        "environment": current_host["environment"],
        "provider": "Proton",
    }
    output = [
        "# HELP grayhaven_proton_telemetry_success Proton public service-health telemetry collection success.",
        "# TYPE grayhaven_proton_telemetry_success gauge",
        "# HELP grayhaven_proton_service_status Proton public service-health status.",
        "# TYPE grayhaven_proton_service_status gauge",
    ]

    try:
        components = proton_components()
        output.append(line("grayhaven_proton_telemetry_success", metric_base, 1))
    except (OSError, urllib.error.URLError, json.JSONDecodeError):
        output.append(line("grayhaven_proton_telemetry_success", metric_base, 0))
        return output

    for service in services:
        component_name = str(service.get("component_name", ""))
        component = components.get(component_name, {})
        raw_status = str(component.get("status", "unknown"))
        status = render_status(raw_status)
        metric_labels = dict(metric_base)
        metric_labels["service"] = service["name"]
        metric_labels["component"] = component_name
        metric_labels["status"] = status
        output.append(line("grayhaven_proton_service_status", metric_labels, proton_status_value(raw_status)))

    return output


